# 默认让 Git 自动检测文本文件，统一用 LF 存储
* text=auto eol=lf

# 明确指定某些类型为文本
*.toml text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf

# 二进制文件不转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary